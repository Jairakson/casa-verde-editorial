# Exemplos, sem segredos. Exportar no shell; nenhum carregamento automático de .env.
DATABASE_PATH=./editorial.db
# Ativar atrás de proxy HTTPS; acesso local HTTP exige 0.
COOKIE_SECURE=0
# Render define PORT. HOST permanece localhost por padrão.
HOST=127.0.0.1
PORT=8000
# Inicialização opcional da primeira conta; valores reais apenas no servidor.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Render usa PostgreSQL pela conexão interna configurada pelo Blueprint.
# Nunca versionar um DATABASE_URL real.
# DATABASE_URL=
# Opcional: origem HTTPS pública para sitemap e URLs canônicas.
# PUBLIC_SITE_URL=https://casa-verde-editorial.onrender.com
